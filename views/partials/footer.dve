<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand-symbol" aria-hidden="true"></span>
      <span>Avenia.id &mdash; {{ t.footer.tagline }}</span>
    </div>

    <ul class="footer-links" aria-label="Tautan Platform">
      {{#each socials as s~}}
      <li>
        <a href="{{ s.url }}" rel="noopener" target="_blank">
          <span>{{ s.label }}</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      </li>
      {{~/each}}
      <li>
        <a href="https://github.com/NeaByteLab/DVE" rel="noopener" target="_blank" title="Static Site Generator">
          <span>Powered by DVE</span>
        </a>
      </li>
    </ul>

    <div>
      <p style="margin: 0; font-size: 0.8rem; color: var(--md-sys-color-on-surface-variant);">
        &copy; {{ site.year }} {{ site.name }}. {{ t.footer.rights }} {{ t.footer.author }}.
      </p>
    </div>
  </div>
</footer>
