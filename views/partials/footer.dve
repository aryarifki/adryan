<footer class="site-footer" id="site-footer">
  <div class="container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand & Philosophy -->
      <div class="footer-brand">
        <div class="footer-brand-title">
          <img src="/assets/resources/investowl-logo-v2.png" alt="Investowl icon" class="footer-logo-img" width="36" height="36">
          <span class="brand-name">Investowl<span class="brand-accent">.id</span></span>
        </div>
        <p class="footer-desc">
          Platform riset kuantitatif dan intelijen pasar saham independen yang dirancang untuk investor dan trader bursa Indonesia (BEI). Menyajikan sinyal algoritmik, pelacakan bandarmologi, radar arus modal asing (foreign flow), dan pemetaan graf kepemilikan saham berbasis dataset resmi terverifikasi.
        </p>
      </div>

      <!-- Col 2: Platform Directory -->
      <div class="footer-col-nav">
        <span class="footer-heading">Platform Directory</span>
        <ul class="footer-menu">
          <li><a href="https://investowl.avenia.my.id/" target="_blank" rel="noopener noreferrer">Portal Investowl Live &nearr;</a></li>
          <li><a href="#overview">[01] Platform Overview</a></li>
          <li><a href="#values">[02] Core Foundation</a></li>
          <li><a href="#projects">[03] Product &amp; Ecosystem</a></li>
          <li><a href="#methodology">[04] Telemetry Engine</a></li>
          <li><a href="#ownership">[05] Structural Intelligence</a></li>
          <li><a href="#insights">[06] Riset &amp; Jurnalisme Data</a></li>
        </ul>
      </div>

      <!-- Col 3: Preserved Connections & Source Codes -->
      <div class="footer-col-socials">
        <span class="footer-heading">Koneksi &amp; Kode Sumber</span>
        <ul class="footer-social-list">
          {{#each socials as s~}}
          <li>
            <a class="footer-social-link" href="{{ s.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.label }}">
              <span class="social-icon" aria-hidden="true">{{{ s.iconSvg }}}</span>
              <span class="social-label">{{ s.label }}</span>
              <span class="external-arrow" aria-hidden="true">&nearr;</span>
            </a>
          </li>
          {{~/each}}
          <li>
            <a class="footer-social-link" href="https://github.com/aryarifki/aryarifki.github.io" target="_blank" rel="noopener noreferrer" aria-label="Source Code Landing Page">
              <span class="social-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6"></path><path d="M8 6l-6 6 6 6"></path></svg>
              </span>
              <span class="social-label">Source Code Website Ini</span>
              <span class="external-arrow" aria-hidden="true">&nearr;</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-divider" aria-hidden="true"></div>

    <div class="footer-bottom-bar">
      <p class="footer-copyright">
        &copy; {{ site.year }} {{ site.name }} (Investowl). Hak cipta dilindungi undang-undang. Seluruh dataset disediakan untuk kepentingan riset &amp; edukasi publik.
      </p>

      <div class="footer-badges">
        <a href="https://github.com/aryarifki/aryarifki.github.io" target="_blank" rel="noopener noreferrer" class="badge-pill" title="Lihat kode sumber landing page ini di GitHub">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          <span>Source Code Website</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
        <a href="https://github.com/NeaByteLab/DVE" target="_blank" rel="noopener noreferrer" class="badge-pill" title="Deserve View Engine: Zero Client-Side Framework Overhead">
          <span class="dve-indicator" aria-hidden="true"></span>
          <span>Rendered via DVE</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </div>
</footer>
