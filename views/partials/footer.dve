<footer class="site-footer" id="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-brand-header">
          <span class="brand-symbol" aria-hidden="true"></span>
          <span class="footer-brand-title">Avenia<span class="text-amber">.id</span></span>
        </div>
        <p class="footer-tagline">{{ t.footer.tagline }}</p>
      </div>

      <nav class="footer-nav" aria-label="Terhubung dengan kami">
        <div class="footer-links-group">
          <span class="footer-group-label">Terhubung dengan kami</span>
          <ul class="footer-links-vertical">
            {{#each socials as s~}}
            <li>
              <a class="footer-link-item" href="{{ s.url }}" rel="noopener noreferrer" target="_blank" aria-label="{{ s.label }}">
                <span class="footer-link-icon" aria-hidden="true">{{{ s.iconSvg }}}</span>
                <span>{{ s.label }}</span>
                <span class="footer-arrow" aria-hidden="true">&nearr;</span>
              </a>
            </li>
            {{~/each}}
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {{ site.year }} {{ site.name }}. {{ t.footer.rights }}
      </p>
      <div class="footer-badge-dve">
        <a href="https://github.com/NeaByteLab/DVE" rel="noopener noreferrer" target="_blank" class="footer-dve-pill" title="Static Engine: Deserve View Engine">
          <span class="dve-dot" aria-hidden="true"></span>
          <span>Powered by DVE</span>
        </a>
      </div>
    </div>
  </div>
</footer>
