<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="brand footer-brand" href="{{ base }}">
          <span class="brand-logo-mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </span>
          <span class="brand-name">{{ site.name }}</span>
        </a>
        <p class="footer-motto">{{ t.hero.tagline }}</p>
      </div>

      <div class="footer-social-col">
        <p class="footer-col-label">Channels & Profiles</p>
        <ul class="footer-social-list">
          {{#each socials as s~}}
          <li>
            <a class="footer-social-link" href="{{ s.url }}" rel="noopener" target="_blank">
              <span>{{ s.label }}</span>
              <span class="footer-arrow" aria-hidden="true">&nearr;</span>
            </a>
          </li>
          {{~/each}}
        </ul>
      </div>

      <div class="footer-back-col">
        <a class="btn-top" href="#site-header" aria-label="Back to top">
          <span>Back to top</span>
          <span aria-hidden="true">&uarr;</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {{ site.year }} {{ site.fullName }} ({{ site.name }}). {{ t.footer.rights }}</p>
      <p class="footer-tagline">{{ t.footer.tagline }}</p>
      <p class="footer-built">
        {{ t.footer.built }}
        <a href="https://github.com/NeaByteLab/DVE" rel="noopener" target="_blank" class="engine-link">DVE</a>
      </p>
    </div>
  </div>
</footer>
