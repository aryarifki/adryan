<header class="site-header" id="site-header">
  <div class="header-pill">
    <a class="brand-link" href="{{ base }}" aria-label="Avenia.id — Home">
      <span class="brand-symbol" aria-hidden="true"></span>
      <span class="brand-text">Avenia<span class="brand-domain">.id</span></span>
    </a>

    <nav class="nav-menu" aria-label="Navigasi Utama">
      <a class="nav-item" href="#hero">{{ t.nav.vision }}</a>
      <a class="nav-item" href="#methodology">{{ t.nav.methodology }}</a>
      <a class="nav-item" href="#tools">{{ t.nav.tools }}</a>
      <a class="nav-item" href="#insights">{{ t.nav.insights }}</a>
      <a class="nav-item" href="#dispatch">{{ t.nav.newsletter }}</a>
    </nav>

    <div class="header-actions">
      <a class="btn-header-cta" href="#tools">
        <span>{{ t.nav.cta }}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</header>
