<header class="site-header" id="site-header">
  <div class="header-floating-pill">
    <a class="brand" href="{{ base }}" aria-label="{{ site.name }} — projects exhibition">
      <span class="brand-logo-mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-dot" aria-hidden="true">·</span>
        <span class="brand-sub">Projects</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Main Navigation">
      <a class="nav-link" href="#projects">{{ t.nav.projects }}</a>
      <a class="nav-link" href="#skills">{{ t.nav.skills }}</a>
      <a class="nav-link" href="#about">{{ t.nav.about }}</a>
      <a class="nav-link" href="#experience">{{ t.nav.experience }}</a>
      <a class="nav-link" href="#contact">{{ t.nav.contact }}</a>
    </nav>

    <div class="header-actions">
      <div class="status-chip" title="{{ t.hero.status }}">
        <span class="status-dot-pulse" aria-hidden="true"></span>
        <span class="status-text">{{ t.nav.statusBadge }}</span>
      </div>
    </div>
  </div>
</header>
