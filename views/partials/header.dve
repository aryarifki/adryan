<header class="site-header" id="site-header">
  <div class="header-container">
    <a class="brand" href="{{ base }}" aria-label="Rifky Arya — Personal Portfolio">
      <span class="brand-name">{{ site.fullName }}</span>
    </a>

    <nav class="nav-menu" aria-label="Main Navigation">
      <a class="nav-link" href="#projects">{{ t.nav.projects }}</a>
      <a class="nav-link" href="#skills">{{ t.nav.skills }}</a>
      <a class="nav-link" href="#about">{{ t.nav.about }}</a>
      <a class="nav-link" href="#experience">{{ t.nav.experience }}</a>
      <a class="nav-link" href="#contact">{{ t.nav.contact }}</a>
    </nav>

    <div class="header-actions">
      <a class="header-status" href="#contact" title="{{ t.hero.status }}">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-label">{{ t.nav.statusBadge }}</span>
      </a>
    </div>
  </div>
</header>
