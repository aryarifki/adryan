{{< layouts/main.dve}}
{{#block title}}{{ t.title }}{{/block}}
{{#block body}}

{{!-- HERO --}}
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        {{ t.hero.status }}
      </p>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-eyebrow">{{ t.hero.eyebrow }}</span>
        {{ t.hero.title }}<span class="accent">.</span>
      </h1>
      <p class="hero-tagline">{{ t.hero.tagline }}</p>
      <p class="hero-lead">{{ t.hero.lead }}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">{{ t.hero.ctaPrimary }}</a>
        <a class="btn btn-ghost" href="#contact">{{ t.hero.ctaSecondary }}</a>
      </div>
    </div>
    <figure class="hero-figure">
      <img src="{{ site.avatar }}" alt="{{ site.name }}" width="480" height="480" loading="eager" fetchpriority="high">
      <figcaption class="hero-meta">
        <span>{{ site.location }}</span>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/{{ site.handle }}" rel="noopener" target="_blank">@{{ site.handle }}</a>
      </figcaption>
    </figure>
  </div>
</section>

{{!-- ABOUT --}}
<section id="about" class="section" aria-labelledby="about-title">
  <div class="container section-grid">
    <div class="section-head">
      <h2 id="about-title" class="section-title">{{ t.about.heading }}</h2>
    </div>
    <div class="section-body about-body">
      <div class="prose">
        <p>{{ t.about.body1 }}</p>
        <p>{{ t.about.body2 }}</p>
      </div>
      <dl class="facts" aria-label="{{ t.about.factsHeading }}">
        {{#each t.about.facts as f~}}
        <div class="fact">
          <dt>{{ f.k }}</dt>
          <dd>{{ f.v }}</dd>
        </div>
        {{~/each}}
      </dl>
    </div>
  </div>
</section>

{{!-- PROJECTS --}}
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container section-grid">
    <div class="section-head">
      <h2 id="projects-title" class="section-title">{{ t.projects.heading }}</h2>
      <p class="section-sub">{{ t.projects.sub }}</p>
    </div>
    <div class="section-body">
      <ul class="project-list">
        {{#each projects as p~}}
        <li class="project">
          <a class="project-link" href="{{ p.url }}" rel="noopener" target="_blank">
            <div class="project-top">
              <h3 class="project-name">{{ p.name }}</h3>
              <span class="project-year">{{ p.year }}</span>
            </div>
            <p class="project-desc">{{ t.lang == "id" ? p.id : p.en }}</p>
            <ul class="tags" aria-label="Stack">
              {{#each p.stack as s~}}<li class="tag">{{ s }}</li>{{~/each}}
            </ul>
            <span class="project-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
        {{~/each}}
      </ul>
