{{< layouts/main.dve}}
{{#block title}}{{ t.title }}{{/block}}
{{#block body}}

{{!-- HERO SECTION: PERSONAL INTRODUCTION --}}
<section class="hero-section" id="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-status-pill">
        <span class="status-pulse-dot" aria-hidden="true"></span>
        <span class="status-status-text">{{ t.hero.status }}</span>
      </div>

      <div class="hero-identity">
        <h1 id="hero-title" class="hero-name">{{ site.fullName }}</h1>
        <p class="hero-tagline">{{ t.hero.tagline }}</p>
      </div>

      <p class="hero-lead">{{ t.hero.lead }}</p>

      <div class="hero-meta-row">
        <div class="meta-item">
          <svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>{{ site.location }}</span>
        </div>
        <div class="meta-divider" aria-hidden="true">·</div>
        <div class="meta-item">
          <svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          <span>IDX Analytics &amp; Legal Tech</span>
        </div>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#projects">
          <span>{{ t.hero.ctaPrimary }}</span>
          <span class="btn-arrow" aria-hidden="true">&darr;</span>
        </a>
        <a class="btn btn-secondary" href="#contact">
          <span>{{ t.hero.ctaSecondary }}</span>
        </a>
        <a class="btn btn-outlined" href="https://github.com/{{ site.handle }}" rel="noopener" target="_blank" aria-label="GitHub Profile">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub</span>
          <span class="btn-external-arrow" aria-hidden="true">&nearr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

{{!-- SECTION: FEATURED PROJECTS (PORTFOLIO CORE) --}}
<section class="section projects-section" id="projects" aria-labelledby="projects-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="projects-heading" class="section-title">{{ t.projects.heading }}</h2>
      <p class="section-subtitle">{{ t.projects.sub }}</p>
    </div>

    <div class="projects-grid">
      {{#each projects as p~}}
      <article class="project-card {{#if p.featured}}project-card-featured{{/if}}">
        <div class="project-card-header">
          <div class="project-meta-badges">
            <span class="project-badge">{{ p.badge }}</span>
            <span class="project-year">{{ p.year }}</span>
          </div>
          <a class="project-external-link" href="{{ p.url }}" rel="noopener" target="_blank" aria-label="Visit {{ p.name }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>
        </div>

        <div class="project-card-body">
          <h3 class="project-title">
            <a href="{{ p.url }}" rel="noopener" target="_blank">{{ p.name }}</a>
          </h3>
          <p class="project-description">{{ p.en }}</p>
        </div>

        <div class="project-card-footer">
          <ul class="project-stack" aria-label="Technology Stack">
            {{#each p.stack as s~}}
            <li class="stack-tag">{{ s }}</li>
            {{~/each}}
          </ul>
          <a class="project-action-link" href="{{ p.url }}" rel="noopener" target="_blank">
            <span>Explore</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>
      {{~/each}}
    </div>

    <div class="section-bottom-action">
      <a class="btn btn-secondary" href="https://github.com/{{ site.handle }}?tab=repositories" rel="noopener" target="_blank">
        <span>{{ t.projects.viewAll }}</span>
        <span class="btn-arrow" aria-hidden="true">&nearr;</span>
      </a>
    </div>
  </div>
</section>

{{!-- SECTION: TECHNICAL STACK & DISCIPLINES --}}
<section class="section skills-section" id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="skills-heading" class="section-title">{{ t.skills.heading }}</h2>
      <p class="section-subtitle">{{ t.skills.sub }}</p>
    </div>

    <div class="skills-grid">
      {{#each skills as g~}}
      <div class="skill-category-card">
        <div class="skill-head">
          <span class="skill-accent-bar" aria-hidden="true"></span>
          <h3 class="skill-group-title">{{ g.group.en }}</h3>
        </div>
        <p class="skill-group-desc">{{ g.desc.en }}</p>
        <ul class="skill-chip-list">
          {{#each g.items as item~}}
          <li class="skill-chip">{{ item }}</li>
          {{~/each}}
        </ul>
      </div>
      {{~/each}}
    </div>
  </div>
</section>

{{!-- SECTION: ABOUT THE BUILDER --}}
<section class="section about-section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="about-heading" class="section-title">{{ t.about.heading }}</h2>
      <p class="section-subtitle">{{ t.about.sub }}</p>
    </div>

    <div class="about-grid">
      <div class="about-content">
        <p class="about-lead">{{ t.about.body1 }}</p>
        <p class="about-text">{{ t.about.body2 }}</p>

        <div class="about-quote">
          <span class="quote-symbol" aria-hidden="true">&ldquo;</span>
          <p class="quote-text">Analysis grounded in verified data, zero-bloat architecture, and reproducible automation.</p>
        </div>
      </div>

      <div class="about-specs-card">
        <h3 class="specs-title">{{ t.about.factsHeading }}</h3>
        <dl class="specs-list">
          {{#each t.about.facts as f~}}
          <div class="spec-row">
            <dt class="spec-key">{{ f.k }}</dt>
            <dd class="spec-value">{{ f.v }}</dd>
          </div>
          {{~/each}}
        </dl>
      </div>
    </div>
  </div>
</section>

{{!-- SECTION: EXPERIENCE & TIMELINE --}}
<section class="section experience-section" id="experience" aria-labelledby="experience-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="experience-heading" class="section-title">{{ t.experience.heading }}</h2>
      <p class="section-subtitle">{{ t.experience.sub }}</p>
    </div>

    <div class="timeline-list">
      {{#each experience as x~}}
      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-period">{{ x.period }}</span>
          <span class="timeline-org">{{ x.org }}</span>
        </div>
        <div class="timeline-detail">
          <h3 class="timeline-role">{{ x.role.en }}</h3>
          <p class="timeline-desc">{{ x.desc.en }}</p>
        </div>
      </div>
      {{~/each}}
    </div>
  </div>
</section>

{{!-- SECTION: CONTACT --}}
<section class="section contact-section" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact-card">
      <div class="contact-header">
        <h2 id="contact-heading" class="contact-title">{{ t.contact.heading }}</h2>
        <p class="contact-subtitle">{{ t.contact.sub }}</p>
        <p class="contact-body">{{ t.contact.body }}</p>
      </div>

      <div class="contact-actions">
        <div class="contact-cta-row">
          <a class="btn btn-primary btn-lg" href="mailto:{{ site.email }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>{{ t.contact.cta }}</span>
          </a>
          <button type="button" class="btn btn-secondary btn-lg copy-email-btn" id="copy-email-btn" data-email="{{ site.email }}">
            <span class="copy-text">{{ t.contact.copyEmail }}</span>
            <span class="copy-success" style="display: none;">{{ t.contact.copied }}</span>
          </button>
        </div>

        <div class="contact-channels">
          <span class="channels-label">Direct profiles:</span>
          <div class="channels-list">
            {{#each socials as s~}}
            <a class="channel-link" href="{{ s.url }}" rel="noopener" target="_blank">
              <span>{{ s.label }}</span>
              <span class="channel-arrow" aria-hidden="true">&nearr;</span>
            </a>
            {{~/each}}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{{/block}}
{{/}}
