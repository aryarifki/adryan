{{< layouts/main.dve}}
{{#block title}}{{ site.name }} — Quantitative Market Intelligence &amp; Telemetry{{/block}}
{{#block body}}

{{!-- ══════════════════════════════════════════════════════════════════════
     SECTION 1: HERO — pernyataan besar, bukti angka, aksi utama
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="hero-section" id="overview" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-top reveal">
      <span class="hero-eyebrow mono">&lt;/&gt; {{ site.brandKicker }}</span>
      <span class="status-badge">
        <span class="status-dot" aria-hidden="true"></span>
        <span>KSEI &amp; BEI DATA PIPELINE ONLINE</span>
      </span>
    </div>

    <h1 id="hero-title" class="hero-headline reveal">
      Membaca pasar modal Indonesia <span class="headline-accent">lewat data</span>, bukan rumor.
    </h1>

    <p class="hero-one-liner reveal">
      avenia.id adalah platform analitik kuantitatif independen: pelacakan smart-money (bandarmologi),
      pemetaan kepemilikan saham BEI, dan jurnalisme data berbasis dataset resmi yang bisa diaudit siapa pun.
    </p>

    <div class="hero-cta-group reveal">
      <a href="https://investowl.avenia.my.id/" target="_blank" rel="noopener noreferrer" class="btn-primary" aria-label="Buka Platform Investowl (Live Web App)">
        <span>Luncurkan Platform Live</span>
        <span aria-hidden="true">&nearr;</span>
      </a>
      <a href="#projects" class="btn-secondary-link">
        <span>Jelajahi proyek &amp; riset &darr;</span>
      </a>
    </div>

    <!-- Strip statistik: angka besar bergaya bukti sosial, animasi count-up -->
    <div class="stats-strip reveal" aria-label="Statistik cakupan data avenia.id">
      <div class="stat-cell">
        <span class="stat-val mono"><span data-count="890">0</span>+</span>
        <span class="stat-lbl">Emiten BEI Terindeks</span>
      </div>
      <div class="stat-cell">
        <span class="stat-val mono"><span data-count="2400">0</span>+</span>
        <span class="stat-lbl">Putusan Hukum &amp; Regulasi</span>
      </div>
      <div class="stat-cell">
        <span class="stat-val mono"><span data-count="7">0</span></span>
        <span class="stat-lbl">Platform &amp; Tools Dibangun</span>
      </div>
      <div class="stat-cell">
        <span class="stat-val mono"><span data-count="100">0</span>%</span>
        <span class="stat-lbl">Data Empiris Terbuka</span>
      </div>
    </div>

    <!-- Terminal radar: kartu visual khas avenia -->
    <div class="hero-visual-card reveal" aria-label="Visualisasi Radar Telemetri Pasar">
      <div class="telemetry-header-bar">
        <div class="terminal-dots" aria-hidden="true">
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
        </div>
        <span class="mono">RADAR_TELEMETRY_LIVE.IDX</span>
        <span class="telemetry-live mono">LIVE_STREAM</span>
      </div>

      <div class="hero-img-container">
        <img src="/assets/resources/hero-foreign-flow.svg" alt="Grafik candlestick BBCA dan aliran dana asing kumulatif (cumulative foreign flow) 100 hari terakhir — Investowl" width="1080" height="930" loading="eager">
      </div>

      <div class="telemetry-ticker-grid">
        <div class="ticker-item">
          <span>SMART_MONEY</span>
          <span class="ticker-bull">+12.4B ACC</span>
        </div>
        <div class="ticker-item">
          <span>FOREIGN_FLOW</span>
          <span class="ticker-bull">+84.2M NET</span>
        </div>
        <div class="ticker-item">
          <span>DOMESTIC_ACC</span>
          <span class="ticker-bear">-32.1M DIST</span>
        </div>
        <div class="ticker-item">
          <span>REGIME_STATE</span>
          <span class="ticker-neutral">ACCUMULATION</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pita berjalan: kosakata ekosistem -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span class="marquee-chunk mono">BANDARMOLOGI ✦ WYCKOFF PHASE ✦ KSEI MUTATION ✦ FOREIGN FLOW ✦ UBO GRAPH ✦ SMART MONEY ✦ HMM REGIME ✦ VWAP FLOW ✦ DATA JOURNALISM ✦ OPEN DATASET ✦&nbsp;</span>
    <span class="marquee-chunk mono">BANDARMOLOGI ✦ WYCKOFF PHASE ✦ KSEI MUTATION ✦ FOREIGN FLOW ✦ UBO GRAPH ✦ SMART MONEY ✦ HMM REGIME ✦ VWAP FLOW ✦ DATA JOURNALISM ✦ OPEN DATASET ✦&nbsp;</span>
  </div>
</div>


{{!-- ══════════════════════════════════════════════════════════════════════
     SECTION 2: NILAI — fondasi kerja (data: values)
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="section values-section" id="values" aria-labelledby="values-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow mono">&lt;/&gt; Fondasi</span>
      <h2 id="values-heading" class="section-title">Dibangun di atas bukti, bukan opini</h2>
      <p class="section-desc">
        Tiga prinsip yang menjaga setiap angka, grafik, dan kesimpulan di avenia.id tetap bisa diuji ulang oleh siapa pun.
      </p>
    </div>

    <div class="values-grid">
      {{#each values as v~}}
      <article class="value-card reveal">
        <span class="value-num mono">{{ v.num }}</span>
        <h3 class="value-title">{{ v.title }}</h3>
        <p class="value-desc">{{ v.desc }}</p>
      </article>
      {{~/each}}
    </div>
  </div>
</section>


{{!-- ══════════════════════════════════════════════════════════════════════
     SECTION 3: SHOWCASE — katalog proyek dengan filter kategori
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="section products-section" id="projects" aria-labelledby="products-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow mono">&lt;/&gt; Showcase</span>
      <h2 id="products-heading" class="section-title">Katanya analisis doang, tapi karyanya jadi</h2>
      <p class="section-desc">
        Tujuh platform, pipeline, dan bot otomasi yang aktif beroperasi di ekosistem Avenia — sebagian besar live dan berkode sumber terbuka. Saring berdasarkan kategori untuk menjelajah.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="project-filter-bar reveal" role="tablist" aria-label="Filter kategori modul">
      {{#each categories as cat~}}
      <button
        type="button"
        class="filter-tab-btn {{#if @first}}active{{/if}}"
        data-filter="{{ cat.key }}"
        role="tab"
        aria-selected="{{#if @first}}true{{else}}false{{/if}}"
      >
        <span>{{ cat.label }}</span>
        <span class="filter-count">{{ cat.count }}</span>
      </button>
      {{~/each}}
    </div>

    <!-- Products / Projects Grid -->
    <div class="products-grid" id="projects-grid">
      {{#each projects as p~}}
      <article class="product-card {{#if p.featured}}featured-wide{{/if}}" data-category="{{ p.category }}" data-slug="{{ p.slug }}">
        <div>
          <div class="product-tag-bar">
            <span class="product-code mono">{{ p.tag }} // {{ p.year }}</span>
            {{#if p.isDeployed}}
            <span class="product-status-pill status-live" title="Layanan aktif dan dapat diakses">
              <span class="status-dot" aria-hidden="true"></span>
              <span>LIVE</span>
            </span>
            {{else}}
            <span class="product-status-pill status-source" title="Kode sumber aktif di GitHub">
              <span>SOURCE CODE</span>
            </span>
            {{/if}}
          </div>

          <h3 class="product-name">
            <a href="{{ p.targetUrl }}" target="_blank" rel="noopener noreferrer">
              {{ p.name }}
            </a>
          </h3>

          <p class="product-description">
            {{ p.summary }}
          </p>

          <div class="product-stack-list" aria-label="Teknologi yang digunakan">
            {{#each p.stack as s~}}
            <span class="stack-tag">{{ s }}</span>
            {{~/each}}
          </div>
        </div>

        <div class="product-card-footer">
          <a href="{{ p.targetUrl }}" target="_blank" rel="noopener noreferrer" class="product-main-btn" aria-label="Akses {{ p.name }}">
            {{#if p.actionText}}
              <span>{{ p.actionText }}</span>
            {{else}}
              {{#if p.isDeployed}}
                <span>Luncurkan Web App</span>
              {{else}}
                <span>Periksa Source Code</span>
              {{/if}}
            {{/if}}
            <span aria-hidden="true">&nearr;</span>
          </a>

          <div class="product-links-group">
            {{#if p.communityUrl}}
            <a href="{{ p.communityUrl }}" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Gabung Komunitas Telegram" aria-label="Komunitas Telegram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </a>
            {{/if}}

            {{#if p.instagramUrl}}
            <a href="{{ p.instagramUrl }}" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Kunjungi Akun Instagram Resmi" aria-label="Instagram Resmi">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            {{/if}}

            {{#if p.repoUrl}}
            <a href="{{ p.repoUrl }}" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Buka Repositori GitHub" aria-label="Kode Sumber GitHub">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            {{/if}}
          </div>
        </div>
      </article>
      {{~/each}}
    </div>

    <!-- Landing Page Source Code Callout Banner -->
    <div class="landing-source-banner reveal">
      <div class="source-banner-content">
        <div class="source-banner-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </div>
        <div>
          <h4 class="source-banner-title">Kode Sumber Landing Page Ini</h4>
          <p class="source-banner-desc">Halaman avenia.my.id dibangun &amp; dikompilasi statis dengan DVE (Deserve View Engine) tanpa runtime framework berat di sisi klien.</p>
        </div>
      </div>
      <a href="https://github.com/aryarifki/aryarifki.github.io" target="_blank" rel="noopener noreferrer" class="btn-source-link">
        <span>Buka Repositori di GitHub</span>
        <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
  </div>
</section>


{{!-- ══════════════════════════════════════════════════════════════════════
     SECTION 4: RADAR — seksi interaktif: tabel mutasi KSEI yang bisa dicari
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="section radar-section" id="radar" aria-labelledby="radar-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow mono">&lt;/&gt; Radar Data</span>
      <h2 id="radar-heading" class="section-title">Lihat sendiri mutasinya, jangan katanya</h2>
      <p class="section-desc">
        Cuplikan radar mutasi kepemilikan KSEI: indeks kustodian sentral dipetakan ke jaringan penerima manfaat akhir (UBO).
        Ketik nama entitas atau tipe untuk menyaring tabelnya langsung.
      </p>
    </div>

    <div class="telemetry-strip reveal" aria-label="Cakupan telemetri avenia.id">
      {{#each telemetry as tm~}}
      <div class="telemetry-cell">
        <span class="telemetry-val mono">{{ tm.value }}</span>
        <span class="telemetry-lbl">{{ tm.label }}</span>
        <span class="telemetry-sub">{{ tm.sub }}</span>
      </div>
      {{~/each}}
    </div>

    <div class="data-card reveal" aria-label="Radar Mutasi KSEI (sampel data)">
      <div class="data-card-header">
        <span class="mono">SAMPLE_KSEI_MUTATION_RADAR</span>
        <span class="mono data-card-live">LIVE_STREAM</span>
      </div>

      <div class="radar-tools">
        <label class="radar-search-label" for="radar-search">Saring entitas</label>
        <input type="search" id="radar-search" class="radar-search" placeholder="Coba: foreign, accum, ubo…" autocomplete="off">
        <span class="radar-count mono" id="radar-count" role="status"></span>
      </div>

      <div class="table-responsive">
        <table class="table-simulated" id="radar-table">
          <thead>
            <tr>
              <th scope="col">ENTITY / BROKER</th>
              <th scope="col">TYPE</th>
              <th scope="col">MUTATION</th>
              <th scope="col">STATUS</th>
            </tr>
          </thead>
          <tbody>
            {{#each kseiMutations as km~}}
            <tr>
              <td>{{ km.entity }}</td>
              <td>{{ km.type }}</td>
              <td>{{ km.mutation }}</td>
              <td><span class="{{ km.statusClass }}">{{ km.status }}</span></td>
            </tr>
            {{~/each}}
          </tbody>
        </table>
      </div>
      <p class="radar-empty" id="radar-empty" hidden>Tidak ada entitas yang cocok. Coba kata kunci lain.</p>

      <div class="network-graph-card">
        <img src="/assets/resources/top10-grup-mtd.svg" alt="Peringkat Top 10 grup konglomerasi BEI berdasarkan rata-rata MTD — Hashim, Happy Hapsoro, SSI Group, Low Tuck Kwong, Lo Kheng Hong, MNC, Provident, Panin, Danantara, Astra" width="1080" height="632" loading="lazy">
      </div>
    </div>

    <ul class="telemetry-list reveal">
      <li class="telemetry-item">
        <span class="telemetry-icon mono">[01]</span>
        <div>
          <h4 class="telemetry-item-title">Bandarmology Accumulation Matrix</h4>
          <p class="telemetry-item-text">Skor akumulasi institusi dari pelacakan broker tertimbang volume (VWAP flow) dan deteksi anomali transfer crossing.</p>
        </div>
      </li>
      <li class="telemetry-item">
        <span class="telemetry-icon mono">[02]</span>
        <div>
          <h4 class="telemetry-item-title">Wyckoff Phase Recognition</h4>
          <p class="telemetry-item-text">Pemetaan siklus struktural pasar otomatis — dari fase akumulasi awal, spring, hingga breakout markup bervolume tinggi.</p>
        </div>
      </li>
      <li class="telemetry-item">
        <span class="telemetry-icon mono">[03]</span>
        <div>
          <h4 class="telemetry-item-title">Foreign Flow Shock Analysis</h4>
          <p class="telemetry-item-text">Identifikasi lonjakan arus dana asing signifikan, memisahkan posisi institusi global dari transaksi ritel jangka pendek.</p>
        </div>
      </li>
    </ul>
  </div>
</section>


{{!-- ══════════════════════════════════════════════════════════════════════
     SECTION 5: RISET — kajian & jurnalisme data terbaru
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="section insights-section" id="insights" aria-labelledby="insights-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow mono">&lt;/&gt; Riset Terbaru</span>
      <h2 id="insights-heading" class="section-title">Kajian yang bisa kamu audit sendiri</h2>
      <p class="section-desc">
        Setiap kajian bertolak dari dataset resmi yang terbuka — terbebas dari bias sensasi dan clickbait pasar.
      </p>
    </div>

    <div class="insights-grid">
      {{#each insights as i~}}
      <article class="insight-card reveal">
        <div>
          <div class="insight-topbar">
            <span class="insight-category-chip">{{ i.category }}</span>
            <span class="insight-dataset-badge">{{ i.badge }}</span>
          </div>

          <h3 class="insight-title">{{ i.title }}</h3>
          <p class="insight-summary">{{ i.summary }}</p>
        </div>

        <div class="insight-sparkline-box" aria-hidden="true">
          <svg viewBox="0 0 240 44" class="sparkline-svg">
            <defs>
              <linearGradient id="sparkgrad-{{ i.slug }}" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#ffb879" stop-opacity="0.25"></stop>
                <stop offset="100%" stop-color="#ffb879" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M 10 32 C 60 26, 100 12, 140 18 C 180 24, 210 34, 230 38 L 230 44 L 10 44 Z" fill="url(#sparkgrad-{{ i.slug }})"></path>
            <path d="M 10 32 C 60 26, 100 12, 140 18 C 180 24, 210 34, 230 38" fill="none" stroke="#ffb879" stroke-width="2.2" stroke-linecap="round"></path>
            <circle cx="230" cy="38" r="4" fill="#ffffff" stroke="#ff9e4f" stroke-width="2.5"></circle>
          </svg>
        </div>

        <div class="insight-footer">
          <span>{{ i.date }} &bull; {{ i.readTime }}</span>
          <span class="insight-action-text">Kajian Lengkap &rarr;</span>
        </div>
      </article>
      {{~/each}}
    </div>
  </div>
</section>


{{!-- ══════════════════════════════════════════════════════════════════════
     SECTION 6: CTA PENUTUP — Data Dispatch
     ══════════════════════════════════════════════════════════════════════ --}}
<section class="section section-dark-cta" id="dispatch" aria-labelledby="dispatch-heading">
  <div class="container">
    <div class="dark-cta-card reveal">
      <span class="dark-cta-kicker mono">&lt;/&gt; Data Dispatch Mingguan</span>
      <h2 id="dispatch-heading" class="dark-cta-title">{{ newsletter.heading }}</h2>
      <p class="dark-cta-sub">{{ newsletter.sub }}</p>

      <form class="dark-cta-form" id="newsletter-form">
        <div class="form-input-group">
          <input type="email" class="dark-cta-input" placeholder="Masukkan alamat email Anda..." required aria-label="Alamat Email untuk Langganan">
          <button type="submit" class="dark-cta-submit-btn">
            <span>{{ newsletter.cta }}</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
        <p class="dark-cta-microcopy">{{ newsletter.microcopy }}</p>
        <div id="newsletter-feedback" class="newsletter-feedback" style="display: none;" role="status"></div>
      </form>
    </div>
  </div>
</section>

{{/block}}
{{/}}
