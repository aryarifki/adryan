          <span class="meta-value mono">avenia.my.id</span>
        </div>
      </div>
    </header>

    <!-- Key Principles Ribbon (Bento-style summary cards) -->
    <section class="legal-principles-grid" aria-label="Prinsip Utama Privasi Kami">
