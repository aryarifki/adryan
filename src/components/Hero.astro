---
import Icon from './Icon.astro';
import { partners, site } from '../data/site';
---

<section
  id="overview"
  class="relative overflow-hidden pb-12 pt-28 sm:pt-32 lg:pb-16 lg:pt-32"
  aria-labelledby="hero-title"
>
  <!-- Ambient light, kept behind the content -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -right-40 -top-32 size-[640px] rounded-full bg-peach-400/[0.09] blur-[110px]"></div>
    <div class="absolute -left-52 top-24 size-[520px] rounded-full bg-violet-700/[0.10] blur-[120px]"></div>
    <div class="absolute bottom-0 left-1/3 h-px w-1/2 bg-gradient-to-r from-transparent via-peach-400/20 to-transparent"></div>
  </div>

  <div class="container-page">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 xl:gap-14">
      <!-- Copy (Hero Left) -->
      <div class="max-w-[620px]">
        <div
          class="reveal inline-flex items-center gap-2.5 rounded-full border border-peach-400/25 bg-peach-400/[0.05] py-1.5 pl-2.5 pr-4 backdrop-blur-md"
        >
          <span class="relative flex size-3.5 items-center justify-center">
            <span class="absolute size-3.5 animate-ping rounded-full bg-peach-400/30"></span>
            <span class="relative size-1.5 rounded-full bg-peach-400 shadow-[0_0_10px_2px_rgba(255,184,121,0.7)]"></span>
          </span>
          <span class="font-mono text-[9.5px] font-bold uppercase tracking-[0.2em] text-peach-300 sm:text-[10.5px]">
            KSEI &amp; BEI DATA PIPELINE ONLINE
          </span>
        </div>

        <h1
          id="hero-title"
          class="reveal mt-5 text-balance text-[2.75rem] font-extrabold leading-[1.04] tracking-[-0.045em] text-white sm:text-[3.45rem] lg:text-[3.75rem] xl:text-[4.05rem]"
          style="--reveal-delay: 60ms"
        >
          Quantitative Market Intelligence
          <span class="text-peach-gradient">&amp; Smart Money Telemetry</span>
        </h1>

        <p
          class="reveal mt-4 max-w-[530px] text-[15px] leading-[1.72] text-slate-300/90 sm:text-[16px] sm:leading-[1.75]"
          style="--reveal-delay: 120ms"
        >
          Platform analitik kuantitatif, pelacakan smart-money (bandarmologi), dan pemetaan
          kepemilikan saham bursa Indonesia (BEI) berbasis matematika inferensial &amp; data empiris terbuka.
        </p>

        <!-- CTA Buttons -->
        <div class="reveal mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center" style="--reveal-delay: 180ms">
          <a
            href={site.investowl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary group"
            aria-label="Buka Platform Investowl (Live Web App)"
          >
            <span>Luncurkan Platform Live</span>
            <Icon
              name="arrow-up-right"
              size={16}
              class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
          </a>
          <a href="#projects" class="btn-ghost group">
            <span class="grid size-6 place-items-center rounded-full border border-white/10 bg-white/[0.05] text-peach-300 transition group-hover:border-peach-400/30">
              <Icon name="play" size={10} class="ml-0.5" />
            </span>
            <span>Eksplorasi Katalog Proyek</span>
          </a>
        </div>

        <!-- Metrics Ribbon -->
        <div
          class="reveal mt-8 grid grid-cols-3 gap-3 rounded-2xl border border-white/[0.08] bg-ink-900/60 p-3.5 backdrop-blur-md sm:gap-4 sm:p-4"
          style="--reveal-delay: 220ms"
          aria-label="Ringkasan Metrik Telemetri"
        >
          <div class="border-r border-white/[0.06] pr-2">
            <span class="block font-mono text-lg font-extrabold text-peach-300 sm:text-xl">99.8%</span>
            <span class="mt-0.5 block text-[11px] font-medium text-slate-400">Akurasi Data</span>
          </div>
          <div class="border-r border-white/[0.06] px-2">
            <span class="block font-mono text-lg font-extrabold text-white sm:text-xl">KSEI / BEI</span>
            <span class="mt-0.5 block text-[11px] font-medium text-slate-400">Mutasi T+1</span>
          </div>
          <div class="pl-2">
            <span class="block font-mono text-lg font-extrabold text-emerald-400 sm:text-xl">WYCKOFF</span>
            <span class="mt-0.5 block text-[11px] font-medium text-slate-400">Phase Engine</span>
          </div>
        </div>

        <!-- Architecture Stack -->
        <div class="reveal mt-8 border-t border-white/[0.08] pt-4.5" style="--reveal-delay: 260ms">
          <p class="text-[8.5px] font-bold uppercase tracking-[0.24em] text-slate-500">
            Arsitektur Pipeline &amp; Komputasi Kuantitatif
          </p>
          <div class="mt-3 grid grid-cols-3 gap-x-3 gap-y-2.5 sm:grid-cols-6 sm:gap-x-4">
            {
              partners.map((partner) => (
                <div class="flex items-center gap-1.5 text-slate-400/80 transition duration-300 hover:text-white">
                  <Icon name={partner.icon} size={13} class="shrink-0 text-peach-400/70" />
                  <span class="truncate text-[10.5px] font-semibold tracking-[-0.01em]">
                    {partner.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Hero Right: Live Radar Telemetry Terminal -->
      <div
        class="reveal relative mx-auto w-full max-w-[540px] lg:max-w-none"
        style="--reveal-delay: 160ms"
        aria-label="Visualisasi Radar Telemetri Pasar"
      >
        <!-- Glow Backdrops -->
        <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-peach-500/15 via-violet-600/10 to-transparent blur-2xl" aria-hidden="true"></div>

        <!-- Terminal Card Frame -->
        <div class="relative overflow-hidden rounded-2xl border border-white/12 bg-ink-900/90 shadow-[0_24px_60px_rgba(0,0,0,0.7)] backdrop-blur-xl">
          <!-- Terminal Header Bar -->
          <div class="flex h-11 items-center justify-between border-b border-white/[0.08] bg-white/[0.025] px-4">
            <div class="flex items-center gap-2">
              <span class="size-2.5 rounded-full bg-rose-500/70"></span>
              <span class="size-2.5 rounded-full bg-amber-500/70"></span>
              <span class="size-2.5 rounded-full bg-emerald-500/70"></span>
              <span class="ml-2 font-mono text-[11px] font-semibold tracking-wider text-slate-400">
                RADAR_TELEMETRY_LIVE.IDX
              </span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
              <span class="font-mono text-[9.5px] font-bold text-emerald-400">FEED_SYNC</span>
            </div>
          </div>

          <!-- Terminal Screen / Image Container -->
          <div class="relative overflow-hidden bg-black/40">
            <img
              src="/assets/resources/hero-matrix.png"
              alt="Obsidian dark matrix with quantitative financial data vectors"
              width="560"
              height="290"
              class="h-[250px] w-full object-cover object-center brightness-95 sm:h-[280px]"
              loading="eager"
            />
            <!-- Dark Vignette Overlay -->
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900 via-transparent to-transparent opacity-80"></div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-900/40 via-transparent to-ink-900/40"></div>

            <!-- Floating Overlay Badge with Minimalist Owl Emblem -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between rounded-xl border border-white/10 bg-ink-900/80 p-2.5 backdrop-blur-md">
              <div class="flex items-center gap-2.5">
                <div class="grid size-8 place-items-center rounded-lg border border-peach-400/30 bg-peach-500/10 text-peach-300">
                  <svg viewBox="0 0 48 48" class="size-5" fill="none">
                    <path
                      d="M24 5 L38 10 V22 C38 31 32 38.5 24 41.5 C16 38.5 10 31 10 22 V10 L24 5 Z"
                      stroke="currentColor"
                      stroke-width="2"
                    />
                    <circle cx="19.5" cy="21.5" r="3.5" stroke="currentColor" stroke-width="1.8" />
                    <circle cx="28.5" cy="21.5" r="3.5" stroke="currentColor" stroke-width="1.8" />
                    <polygon points="24,22 22.5,25.5 25.5,25.5" fill="currentColor" />
                  </svg>
                </div>
                <div>
                  <span class="block text-[11px] font-bold text-white">Investowl Microstructure Engine</span>
                  <span class="block font-mono text-[9.5px] text-slate-400">Idx Volume-Weighted Flow Tracker</span>
                </div>
              </div>
              <span class="rounded border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 font-mono text-[9px] font-bold text-emerald-300">
                T+1 VERIFIED
              </span>
            </div>
          </div>

          <!-- Telemetry Ticker Grid (4 Columns) -->
          <div class="grid grid-cols-2 divide-x divide-y divide-white/[0.06] border-t border-white/[0.08] bg-ink-900/95 sm:grid-cols-4 sm:divide-y-0">
            <div class="p-3 sm:p-3.5">
              <span class="block font-mono text-[9px] font-bold tracking-wider text-slate-500">SMART_MONEY</span>
              <span class="mt-1 block font-mono text-[12px] font-extrabold text-emerald-400 sm:text-[13px]">+12.4B ACC</span>
            </div>
            <div class="p-3 sm:p-3.5">
              <span class="block font-mono text-[9px] font-bold tracking-wider text-slate-500">FOREIGN_FLOW</span>
              <span class="mt-1 block font-mono text-[12px] font-extrabold text-emerald-400 sm:text-[13px]">+84.2M NET</span>
            </div>
            <div class="p-3 sm:p-3.5">
              <span class="block font-mono text-[9px] font-bold tracking-wider text-slate-500">DOMESTIC_ACC</span>
              <span class="mt-1 block font-mono text-[12px] font-extrabold text-rose-400 sm:text-[13px]">-32.1M DIST</span>
            </div>
            <div class="p-3 sm:p-3.5">
              <span class="block font-mono text-[9px] font-bold tracking-wider text-slate-500">REGIME_STATE</span>
              <span class="mt-1 block font-mono text-[11px] font-extrabold text-peach-300 sm:text-[12px]">ACCUMULATION</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
