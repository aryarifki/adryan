---
import Icon from './Icon.astro';
import { categories, projects, site } from '../data/site';
---

<section
  id="projects"
  class="relative border-t border-white/[0.06] py-20 lg:py-28"
  aria-labelledby="projects-heading"
>
  <!-- Background Glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-40 top-1/2 size-[500px] -translate-y-1/2 rounded-full bg-peach-500/[0.04] blur-[120px]"></div>
  </div>

  <div class="container-page">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">SYSTEM MODULES &amp; REPOSITORIES</span>
      <h2
        id="projects-heading"
        class="mt-3 text-balance text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Quantitative Product Suite &amp; Ecosystem
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-400">
        Aplikasi web analitik, pipeline kuantitatif, dan bot otomasi yang aktif beroperasi di ekosistem Avenia dengan kode sumber terbuka.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2" role="tablist" aria-label="Filter kategori modul">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            class={`project-filter-btn flex items-center gap-2 rounded-xl border px-4 py-2 text-xs font-semibold transition-all duration-200 ${
              idx === 0
                ? 'active border-peach-400/40 bg-peach-400/15 text-peach-300 shadow-[0_0_20px_rgba(255,184,121,0.15)]'
                : 'border-white/[0.08] bg-white/[0.02] text-slate-400 hover:border-white/20 hover:text-white'
            }`}
            data-filter={cat.key}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span>{cat.label}</span>
            <span class="rounded-full bg-white/[0.08] px-1.5 py-0.5 font-mono text-[10px]">
              {cat.count}
            </span>
          </button>
        ))
      }
    </div>

    <!-- Projects Grid -->
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="projects-grid">
      {
        projects.map((p) => (
          <article
            class={`project-card group relative flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-ink-900/60 p-6 backdrop-blur-md transition-all duration-300 hover:border-peach-400/30 hover:bg-ink-900/90 hover:shadow-[0_16px_45px_rgba(0,0,0,0.5)] ${
              p.featured ? 'md:col-span-2 lg:col-span-2' : ''
            }`}
            data-category={p.category}
          >
            <div>
              <!-- Tag & Status Bar -->
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[11px] font-semibold text-slate-400">
                  {p.tag} // {p.year}
                </span>
                {p.isDeployed ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[9.5px] font-bold text-emerald-400">
                    <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                    <span>LIVE</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center rounded-full border border-slate-700 bg-slate-800/80 px-2.5 py-0.5 font-mono text-[9.5px] font-bold text-slate-300">
                    <span>SOURCE CODE</span>
                  </span>
                )}
              </div>

              <!-- Name -->
              <h3 class="mt-4 text-xl font-bold tracking-tight text-white transition-colors group-hover:text-peach-200">
                <a
                  href={p.targetUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="focus:outline-none"
                >
                  {p.name}
                </a>
              </h3>

              <!-- Summary -->
              <p class="mt-2.5 text-xs leading-relaxed text-slate-400">
                {p.summary}
              </p>

              <!-- Stack Tags -->
              <div class="mt-5 flex flex-wrap gap-1.5">
                {p.stack.map((tech) => (
                  <span class="rounded-md border border-white/[0.06] bg-white/[0.03] px-2 py-0.5 font-mono text-[10.5px] text-slate-400">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer Action & Secondary Links -->
            <div class="mt-7 flex items-center justify-between border-t border-white/[0.06] pt-4">
              <a
                href={p.targetUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-peach-300 transition hover:text-white"
                aria-label={`Akses ${p.name}`}
              >
                <span>{p.actionText}</span>
                <Icon name="arrow-up-right" size={13} />
              </a>

              <div class="flex items-center gap-1.5">
                {p.communityUrl && (
                  <a
                    href={p.communityUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="grid size-7.5 place-items-center rounded-lg border border-white/[0.08] bg-white/[0.02] text-slate-400 transition hover:border-peach-400/30 hover:text-white"
                    title="Gabung Komunitas Telegram"
                    aria-label="Komunitas Telegram"
                  >
                    <Icon name="send" size={13} />
                  </a>
                )}
                {p.repoUrl && (
                  <a
                    href={p.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="grid size-7.5 place-items-center rounded-lg border border-white/[0.08] bg-white/[0.02] text-slate-400 transition hover:border-peach-400/30 hover:text-white"
                    title="Buka Repositori GitHub"
                    aria-label="Kode Sumber GitHub"
                  >
                    <Icon name="github" size={13} />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Source Code Callout Banner -->
    <div class="mt-14 flex flex-col items-start justify-between gap-5 rounded-2xl border border-white/10 bg-gradient-to-r from-ink-900 via-ink-900/80 to-ink-950 p-6 backdrop-blur-md sm:flex-row sm:items-center sm:p-7">
      <div class="flex items-center gap-4">
        <div class="grid size-11 shrink-0 place-items-center rounded-xl border border-peach-400/30 bg-peach-400/10 text-peach-300">
          <Icon name="code" size={20} />
        </div>
        <div>
          <h4 class="text-sm font-bold text-white sm:text-base">Kode Sumber Landing Page Ini</h4>
          <p class="mt-0.5 text-xs text-slate-400">
            Halaman avenia.my.id dibangun &amp; dikompilasi statis dengan Astro 6 &amp; Tailwind CSS 4 tanpa runtime framework berat di sisi klien.
          </p>
        </div>
      </div>
      <a
        href={site.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2.5 text-xs font-bold text-white transition hover:border-peach-400/30 hover:bg-white/[0.08]"
      >
        <span>Buka Repositori di GitHub</span>
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>
</section>

<!-- Client Script for Category Filtering -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.project-filter-btn');
    const cards = document.querySelectorAll('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active classes
        filterButtons.forEach((b) => {
          b.classList.remove('active', 'border-peach-400/40', 'bg-peach-400/15', 'text-peach-300', 'shadow-[0_0_20px_rgba(255,184,121,0.15)]');
          b.classList.add('border-white/[0.08]', 'bg-white/[0.02]', 'text-slate-400');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.remove('border-white/[0.08]', 'bg-white/[0.02]', 'text-slate-400');
        btn.classList.add('active', 'border-peach-400/40', 'bg-peach-400/15', 'text-peach-300', 'shadow-[0_0_20px_rgba(255,184,121,0.15)]');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
