---
import Icon from './Icon.astro';
import { insights, testimonials } from '../data/site';
---

<section
  id="insights"
  class="relative border-t border-white/[0.06] bg-ink-950/40 py-20 lg:py-28"
  aria-labelledby="insights-heading"
>
  <div class="container-page">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">RISET &amp; INVESTIGASI EMPIRIS</span>
      <h2
        id="insights-heading"
        class="mt-3 text-balance text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Featured Insights &amp; Data Journalism
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-400">
        Kajian mendalam berbasis dataset resmi yang dapat diaudit publik, terbebas dari bias sensasi dan clickbait pasar.
      </p>
    </div>

    <!-- 3 Insights Cards -->
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        insights.map((item, idx) => (
          <article class="reveal group flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-ink-900/60 p-6 backdrop-blur-md transition-all duration-300 hover:border-peach-400/30 hover:bg-ink-900/90 hover:shadow-[0_12px_40px_rgba(255,184,121,0.08)]">
            <div>
              <!-- Top Badges -->
              <div class="flex items-center justify-between gap-2">
                <span class="rounded-full border border-peach-400/25 bg-peach-400/10 px-2.5 py-0.5 text-[10px] font-bold text-peach-300">
                  {item.category}
                </span>
                <span class="font-mono text-[10px] font-semibold text-slate-400">
                  {item.badge}
                </span>
              </div>

              <!-- Title -->
              <h3 class="mt-4 text-lg font-bold leading-snug tracking-tight text-white transition-colors group-hover:text-peach-200">
                {item.title}
              </h3>

              <!-- Summary -->
              <p class="mt-2.5 text-xs leading-relaxed text-slate-400">
                {item.summary}
              </p>
            </div>

            <div>
              <!-- Dynamic Micro-Sparkline Chart -->
              <div class="my-5 overflow-hidden rounded-lg border border-white/[0.05] bg-black/30 p-2" aria-hidden="true">
                <svg viewBox="0 0 240 44" class="w-full">
                  <defs>
                    <linearGradient id={`sparkgrad-${item.slug}`} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#ffb879" stop-opacity="0.3"></stop>
                      <stop offset="100%" stop-color="#ffb879" stop-opacity="0"></stop>
                    </linearGradient>
                  </defs>
                  <path
                    d="M 10 32 C 60 26, 100 12, 140 18 C 180 24, 210 34, 230 38 L 230 44 L 10 44 Z"
                    fill={`url(#sparkgrad-${item.slug})`}
                  ></path>
                  <path
                    d="M 10 32 C 60 26, 100 12, 140 18 C 180 24, 210 34, 230 38"
                    fill="none"
                    stroke="#ffb879"
                    stroke-width="2"
                    stroke-linecap="round"
                  ></path>
                  <circle cx="230" cy="38" r="3.5" fill="#0E0C15" stroke="#ffb879" stroke-width="2"></circle>
                </svg>
              </div>

              <!-- Footer -->
              <div class="flex items-center justify-between border-t border-white/[0.06] pt-3 text-xs text-slate-400">
                <span>{item.date} &bull; {item.readTime}</span>
                <span class="inline-flex items-center gap-1 font-semibold text-peach-300 transition group-hover:translate-x-0.5">
                  <span>Kajian</span>
                  <Icon name="arrow-right" size={12} />
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Community & Peer Reviews Ribbon -->
    <div class="mt-16 rounded-3xl border border-white/[0.07] bg-white/[0.015] p-6 lg:p-8">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-peach-300">PEER VERIFICATION</span>
          <h4 class="mt-1 text-xl font-bold text-white">Dipercaya oleh Praktisi Pasar Modal</h4>
        </div>
        <span class="text-xs text-slate-400">Feedback Komunitas Kuantitatif</span>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          testimonials.map((t) => (
            <div class="rounded-xl border border-white/[0.06] bg-ink-900/60 p-4.5 backdrop-blur-sm">
              <p class="text-xs leading-relaxed text-slate-300/90 italic">
                "{t.quote}"
              </p>
              <div class="mt-4 flex items-center gap-2.5 border-t border-white/[0.05] pt-3">
                <span class="grid size-7 place-items-center rounded-full bg-peach-400/15 font-mono text-[10px] font-bold text-peach-300">
                  {t.initials}
                </span>
                <div>
                  <span class="block text-xs font-bold text-white">{t.name}</span>
                  <span class="block text-[10px] text-slate-400">{t.role}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
