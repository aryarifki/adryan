---
import Icon from './Icon.astro';
import { insights, testimonials } from '../data/site';

const avatarTones: Record<string, string> = {
  peach: 'bg-[linear-gradient(145deg,#FFE2C7_0%,#FFB879_48%,#F27C1F_100%)]',
  violet: 'bg-[linear-gradient(145deg,#EDE9FE_0%,#A78BFA_48%,#6D28D9_100%)]',
  teal: 'bg-[linear-gradient(145deg,#CCFBF1_0%,#5EEAD4_48%,#0F766E_100%)]',
  blue: 'bg-[linear-gradient(145deg,#DBEAFE_0%,#93C5FD_48%,#1D4ED8_100%)]',
};
---

<section id="testimonials" class="relative py-20 lg:py-28" aria-labelledby="testimonials-title">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[320px] w-[760px] -translate-x-1/2 rounded-full bg-peach-400/[0.045] blur-[110px]"></div>
  </div>

  <div class="container-page">
    <!-- Testimonials Header -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Kredibilitas &amp; Risalah</span>
      <h2 id="testimonials-title" class="section-title mt-4">
        Dipercaya Praktisi Pasar &amp; Analis Data
      </h2>
      <p class="section-copy mx-auto mt-4 max-w-lg">
        Tim riset, analis kuantitatif, dan investor independen memanfaatkan Investowl untuk
        menggantikan narasi spekulatif dengan data empiris yang dapat diaudit.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="mt-12 grid gap-3.5 sm:grid-cols-2 xl:grid-cols-4">
      {
        testimonials.map((testimonial, index) => (
          <figure
            class="reveal group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-peach-400/35 hover:bg-white/[0.05]"
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <span
              class="pointer-events-none absolute -right-8 -top-8 size-24 rounded-full bg-peach-400/[0.06] blur-2xl transition-opacity duration-500 group-hover:opacity-100"
              aria-hidden="true"
            ></span>
            <Icon name="quote" size={26} class="absolute right-4 top-4 text-peach-400/20" />

            <div class="flex justify-center">
              <span class:list={['avatar-3d', avatarTones[testimonial.tone]]}>
                {testimonial.initials}
              </span>
            </div>

            <div class="mt-3.5 flex justify-center gap-0.5 text-peach-400" aria-label="5 dari 5 bintang">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={10} class="fill-peach-400" />
              ))}
            </div>

            <blockquote class="mt-4 flex-1 text-center text-[12.5px] leading-[1.7] text-slate-400">
              “{testimonial.quote}”
            </blockquote>

            <figcaption class="mt-5 border-t border-white/[0.07] pt-4 text-center">
              <p class="text-[12px] font-bold tracking-[-0.01em] text-white">{testimonial.name}</p>
              <p class="mt-1 text-[8px] font-bold uppercase tracking-[0.14em] text-slate-600">
                {testimonial.role}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Featured Insights Section (from DVE Section 6) -->
    <div class="reveal mt-20 border-t border-white/[0.08] pt-16" id="insights">
      <div class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
        <div>
          <span class="eyebrow">RISET &amp; INVESTIGASI EMPIRIS</span>
          <h3 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Featured Insights &amp; Data Journalism
          </h3>
          <p class="mt-2 max-w-xl text-[13px] text-slate-400">
            Kajian mendalam berbasis dataset resmi yang dapat diaudit publik, terbebas dari bias sensasi pasar.
          </p>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          insights.map((insight, idx) => (
            <article
              class="reveal group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-white/[0.025] p-5 transition duration-300 hover:border-peach-400/35 hover:bg-white/[0.045]"
              style={`--reveal-delay: ${idx * 90}ms`}
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-full bg-peach-400/10 px-2 py-0.5 text-[8px] font-bold uppercase tracking-[0.14em] text-peach-300">
                    {insight.category}
                  </span>
                  <span class="text-[8px] font-medium text-slate-500">
                    {insight.badge}
                  </span>
                </div>
                <h4 class="mt-3 text-[14px] font-bold leading-snug text-white group-hover:text-peach-200">
                  {insight.title}
                </h4>
                <p class="mt-2 text-[11.5px] leading-relaxed text-slate-400">
                  {insight.summary}
                </p>
              </div>

              <div class="mt-5 flex items-center justify-between border-t border-white/[0.06] pt-3 text-[9px] text-slate-500">
                <span>{insight.date} &bull; {insight.readTime}</span>
                <span class="font-semibold text-peach-400 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                  Kajian Lengkap &rarr;
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
