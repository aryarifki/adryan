---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';

const avatarTones: Record<string, string> = {
  peach: 'bg-[linear-gradient(145deg,#FFE2C7_0%,#FFB879_48%,#F27C1F_100%)]',
  violet: 'bg-[linear-gradient(145deg,#EDE9FE_0%,#A78BFA_48%,#6D28D9_100%)]',
  teal: 'bg-[linear-gradient(145deg,#CCFBF1_0%,#5EEAD4_48%,#0F766E_100%)]',
  blue: 'bg-[linear-gradient(145deg,#DBEAFE_0%,#93C5FD_48%,#1D4ED8_100%)]',
};
---

<section id="testimonials" class="relative py-20 lg:py-28" aria-labelledby="testimonials-title">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[320px] w-[760px] -translate-x-1/2 rounded-full bg-peach-400/[0.045] blur-[110px]"></div>
  </div>

  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Testimonials</span>
      <h2 id="testimonials-title" class="section-title mt-4">
        What people say about us
      </h2>
      <p class="section-copy mx-auto mt-4 max-w-lg">
        Research teams, analysts, and independent investors use Avenia to replace
        narrative with something they can check.
      </p>
    </div>

    <div class="mt-12 grid gap-3.5 sm:grid-cols-2 xl:grid-cols-4">
      {
        testimonials.map((testimonial, index) => (
          <figure
            class="reveal group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-5 backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-peach-400/35 hover:bg-white/[0.05]"
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <span
              class="pointer-events-none absolute -right-8 -top-8 size-24 rounded-full bg-peach-400/[0.06] blur-2xl transition-opacity duration-500 group-hover:opacity-100"
              aria-hidden="true"
            ></span>
            <Icon name="quote" size={26} class="absolute right-4 top-4 text-peach-400/20" />

            <div class="flex justify-center">
              <span class:list={['avatar-3d', avatarTones[testimonial.tone]]}>
                {testimonial.initials}
              </span>
            </div>

            <div class="mt-3.5 flex justify-center gap-0.5 text-peach-400" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={10} class="fill-peach-400" />
              ))}
            </div>

            <blockquote class="mt-4 flex-1 text-center text-[12.5px] leading-[1.7] text-slate-400">
              “{testimonial.quote}”
            </blockquote>

            <figcaption class="mt-5 border-t border-white/[0.07] pt-4 text-center">
              <p class="text-[12px] font-bold tracking-[-0.01em] text-white">{testimonial.name}</p>
              <p class="mt-1 text-[8px] font-bold uppercase tracking-[0.14em] text-slate-600">
                {testimonial.role}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="reveal mt-6 text-center text-[9px] text-slate-600">
      Launch preview — endorsements are placeholder copy pending verification.
    </p>
  </div>
</section>
