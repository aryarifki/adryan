---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { footerColumns, site, socials } from '../data/site';
---

<footer class="relative overflow-hidden border-t border-white/10 bg-[#09070f]/85">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/4 top-0 h-64 w-[520px] rounded-full bg-peach-400/[0.035] blur-[100px]"></div>
    <span class="absolute inset-x-0 -bottom-12 select-none text-center text-[19vw] font-extrabold leading-none tracking-[-0.08em] text-white/[0.018]">
      investowl
    </span>
  </div>

  <div class="container-page relative py-14 lg:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.55fr_1fr_1fr_1fr_1fr] lg:gap-8">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-4 text-[12.5px] leading-6 text-slate-500">
          Platform riset kuantitatif dan intelijen pasar saham independen yang dirancang untuk investor dan
          pelaku bursa Indonesia (BEI). Menyajikan sinyal algoritmik, pelacakan bandarmologi, radar arus modal asing,
          dan pemetaan graf kepemilikan saham berbasis dataset resmi terverifikasi.
        </p>

        <a
          href={site.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-[11px] font-semibold text-slate-300 transition hover:border-peach-400/35 hover:text-peach-300"
        >
          <Icon name="telegram" size={12} class="text-peach-400" />
          {site.telegramHandle}
        </a>

        <div class="mt-5 flex items-center gap-2">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                title={social.label}
                class="grid size-9 place-items-center rounded-full border border-white/10 bg-white/[0.025] text-slate-400 transition duration-300 hover:-translate-y-0.5 hover:border-peach-400/40 hover:bg-peach-400/10 hover:text-peach-300"
              >
                <Icon name={social.icon} size={15} />
              </a>
            ))
          }
        </div>
      </div>

      {
        footerColumns.map((column) => (
          <div>
            <h2 class="text-[9px] font-bold uppercase tracking-[0.2em] text-slate-300">
              {column.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link"
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                    {link.external && <Icon name="arrow-up-right" size={10} class="text-slate-700" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/[0.08] pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[10.5px] leading-5 text-slate-600">
        &copy; {site.year} Avenia.id (Investowl). Hak cipta dilindungi undang-undang. Seluruh dataset disediakan untuk kepentingan riset &amp; edukasi publik.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[9.5px] font-medium text-slate-600">
        <span class="font-mono tracking-[0.04em]">{site.domain}</span>
        <a href={site.repo} target="_blank" rel="noopener noreferrer" class="transition hover:text-peach-300">
          Astro + Tailwind CSS
        </a>
        <a href="#overview" class="inline-flex items-center gap-1 transition hover:text-peach-300">
          Kembali ke atas
          <Icon name="arrow-up" size={10} />
        </a>
      </div>
    </div>
  </div>
</footer>
