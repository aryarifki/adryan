---
interface Props {
  class?: string;
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  showSubtitle?: boolean;
}

const {
  class: className = '',
  href = '/',
  size = 'md',
  showSubtitle = true,
} = Astro.props;

const isSmall = size === 'sm';
const isLarge = size === 'lg';
---

<a
  href={href}
  class:list={['group inline-flex items-center gap-2.5 transition-opacity hover:opacity-95', className]}
  aria-label="Investowl.id — Avenia Halaman Utama"
>
  <span
    class:list={[
      'relative grid place-items-center overflow-hidden rounded-[11px] border border-peach-400/30 bg-gradient-to-br from-[#1b1526] via-[#120e1c] to-[#0a0812] text-peach-300 shadow-[0_8px_24px_-10px_rgba(255,184,121,0.55),inset_0_1px_0_rgba(255,255,255,0.12)] transition-transform duration-300 group-hover:-rotate-2 group-hover:scale-105 group-hover:border-peach-400/60',
      isSmall ? 'size-8 p-1' : isLarge ? 'size-11 p-1.5' : 'size-9 p-1.5',
    ]}
  >
    <span
      class="absolute inset-0 bg-[radial-gradient(circle_at_35%_25%,rgba(255,184,121,0.22),transparent_65%)]"
      aria-hidden="true"
    ></span>

    <!-- Elegant Minimalist InvestOwl Emblem SVG -->
    <svg
      viewBox="0 0 48 48"
      class="relative size-full"
      fill="none"
      stroke="currentColor"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="logoEmblemGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFE3C8" />
          <stop offset="45%" stop-color="#FFB879" />
          <stop offset="100%" stop-color="#FF9033" />
        </linearGradient>
      </defs>

      <!-- Shield Frame -->
      <path
        d="M24 4.5 L39 10 V23 C39 32.5 32.5 40.5 24 43.5 C15.5 40.5 9 32.5 9 23 V10 L24 4.5 Z"
        stroke="url(#logoEmblemGrad)"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="opacity-90"
      />
      <!-- Brow / Horns -->
      <path
        d="M14 15.5 L20.5 19 L24 16.5 L27.5 19 L34 15.5"
        stroke="url(#logoEmblemGrad)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <!-- Telemetry Eyes -->
      <circle cx="19" cy="24" r="4.5" stroke="url(#logoEmblemGrad)" stroke-width="1.6" />
      <circle cx="19" cy="24" r="1.6" fill="url(#logoEmblemGrad)" />
      <circle cx="29" cy="24" r="4.5" stroke="url(#logoEmblemGrad)" stroke-width="1.6" />
      <circle cx="29" cy="24" r="1.6" fill="url(#logoEmblemGrad)" />
      <!-- Sharp Beak -->
      <polygon points="24,24.5 22.2,28.5 25.8,28.5" fill="url(#logoEmblemGrad)" />
      <!-- Wings -->
      <path
        d="M15.5 31.5 C18.5 34.5 21 36.5 24 37.5 C27 36.5 29.5 34.5 32.5 31.5"
        stroke="url(#logoEmblemGrad)"
        stroke-width="1.6"
        stroke-linecap="round"
      />
    </svg>
  </span>

  <span class="flex flex-col">
    <span
      class:list={[
        'font-extrabold tracking-[-0.04em] text-white transition-colors group-hover:text-peach-200',
        isSmall ? 'text-[16px] leading-tight' : 'text-[19px] leading-none',
      ]}
    >
      Investowl<span class="text-peach-400">.id</span>
    </span>
    {showSubtitle && !isSmall && (
      <span class="mt-0.5 text-[8px] font-bold uppercase tracking-[0.18em] text-slate-500">
        Market Intelligence
      </span>
    )}
  </span>
</a>
