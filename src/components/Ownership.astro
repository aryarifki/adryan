---
import Icon from './Icon.astro';
import { kseiMutations } from '../data/site';
---

<section
  id="ownership"
  class="relative border-t border-white/[0.06] py-20 lg:py-28"
  aria-labelledby="ownership-heading"
>
  <div class="container-page">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Narrative Left -->
      <div>
        <span class="eyebrow">STRUCTURAL INTELLIGENCE</span>
        <h2
          id="ownership-heading"
          class="mt-3 text-balance text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
        >
          Mapping Indonesian Equity Market DNA
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-slate-300/90 sm:text-base">
          Dengan mengindeks data kustodian sentral KSEI dan memetakan jaringan konglomerasi pengendali, Investowl memungkinkan trader melihat melampaui pergerakan harga dangkal menuju struktur penerima manfaat sebenarnya (<span class="font-semibold text-white">Ultimate Beneficial Owner</span>).
        </p>
        <p class="mt-3 text-xs leading-relaxed text-slate-400 sm:text-sm">
          Temukan pola sindikasi broker, akun nominee terafiliasi, dan mutasi pemegang saham bulanan &gt;5% di seluruh emiten yang tercatat di Bursa Efek Indonesia.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-white/[0.08] pt-6">
          <div class="flex items-center gap-2">
            <span class="grid size-6 place-items-center rounded-full bg-emerald-500/10 text-emerald-400">
              <Icon name="check" size={12} />
            </span>
            <span class="text-xs font-semibold text-slate-300">Deteksi Nominee Asing</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="grid size-6 place-items-center rounded-full bg-emerald-500/10 text-emerald-400">
              <Icon name="check" size={12} />
            </span>
            <span class="text-xs font-semibold text-slate-300">Crossing Saham Terafiliasi</span>
          </div>
        </div>
      </div>

      <!-- Data Card Right: Simulated KSEI Mutation Radar -->
      <div class="reveal relative" style="--reveal-delay: 100ms">
        <div class="absolute -inset-2 rounded-3xl bg-peach-400/[0.08] blur-2xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-2xl border border-white/12 bg-ink-900/95 shadow-[0_20px_50px_rgba(0,0,0,0.6)] backdrop-blur-xl">
          <!-- Card Header -->
          <div class="flex h-11 items-center justify-between border-b border-white/[0.08] bg-white/[0.025] px-4.5">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-peach-400"></span>
              <span class="font-mono text-xs font-bold text-white">SAMPLE_KSEI_MUTATION_RADAR</span>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-peach-400/30 bg-peach-400/10 px-2 py-0.5 font-mono text-[9.5px] font-bold text-peach-300">
              <span class="size-1 animate-pulse rounded-full bg-peach-400"></span>
              <span>LIVE_STREAM</span>
            </span>
          </div>

          <!-- Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-white/[0.06] bg-black/30 font-mono text-[10px] text-slate-400">
                <tr>
                  <th scope="col" class="py-3 pl-4 pr-3 font-semibold">ENTITY / BROKER</th>
                  <th scope="col" class="px-3 py-3 font-semibold">TYPE</th>
                  <th scope="col" class="px-3 py-3 font-semibold">MUTATION</th>
                  <th scope="col" class="py-3 pl-3 pr-4 font-semibold">STATUS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/[0.05] font-mono text-[11px]">
                {
                  kseiMutations.map((km) => (
                    <tr class="transition-colors hover:bg-white/[0.02]">
                      <td class="whitespace-nowrap py-3 pl-4 pr-3 font-semibold text-white">
                        {km.entity}
                      </td>
                      <td class="whitespace-nowrap px-3 py-3 text-slate-400">
                        {km.type}
                      </td>
                      <td class="whitespace-nowrap px-3 py-3 font-bold text-slate-200">
                        {km.mutation}
                      </td>
                      <td class="whitespace-nowrap py-3 pl-3 pr-4">
                        <span class={`inline-block rounded border px-2 py-0.5 text-[9.5px] font-extrabold ${km.statusClass}`}>
                          {km.status}
                        </span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <!-- Graph Net Visual Container -->
          <div class="border-t border-white/[0.08] bg-black/40">
            <img
              src="/assets/resources/graph-net.png"
              alt="Dark metallic graph map showing connected glowing network nodes"
              width="560"
              height="180"
              class="h-[140px] w-full object-cover object-center opacity-85"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
