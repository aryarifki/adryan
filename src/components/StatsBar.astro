---
import { stats } from '../data/site';
---

<section class="relative pb-6" aria-label="Metrik telemetri platform">
  <div class="container-page">
    <div
      class="reveal grid grid-cols-1 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.025] shadow-[0_20px_60px_-40px_rgba(0,0,0,0.9)] backdrop-blur-md sm:grid-cols-2 lg:grid-cols-4 sm:divide-y-0 lg:divide-x"
    >
      {
        stats.map((stat, index) => (
          <div class="group relative flex flex-col justify-center px-6 py-6 transition-colors duration-300 hover:bg-white/[0.02] sm:px-7 sm:py-7">
            <span class="absolute right-5 top-4 font-mono text-[9px] tracking-[0.2em] text-white/15">
              0{index + 1}
            </span>
            <div class="flex items-end gap-3">
              <span class="font-mono text-[2.15rem] font-semibold leading-none tracking-[-0.06em] text-white sm:text-[2.3rem]">
                {stat.value}
              </span>
              <span class="max-w-[100px] pb-1 text-[8.5px] font-bold uppercase leading-[1.4] tracking-[0.14em] text-peach-400">
                {stat.label}
              </span>
            </div>
            <p class="mt-2.5 text-[10.5px] font-medium text-slate-500">{stat.sub}</p>
            <span class="absolute inset-x-6 bottom-0 h-px origin-left scale-x-0 bg-gradient-to-r from-peach-400/60 to-transparent transition-transform duration-500 group-hover:scale-x-100"></span>
          </div>
        ))
      }
    </div>
  </div>
</section>
