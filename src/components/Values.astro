---
import Icon from './Icon.astro';
import { bento, values } from '../data/site';
---

<section
  id="values"
  class="relative border-t border-white/[0.06] bg-ink-950/40 py-20 lg:py-28"
  aria-labelledby="values-heading"
>
  <div class="container-page">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">CORE FOUNDATION</span>
      <h2
        id="values-heading"
        class="mt-3 text-balance text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Engineered for Evidence-Based Market Precision
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-400">
        Investowl mengeliminasi noise pasar spekulatif dengan memadukan pemodelan kuantitatif matematika yang ketat dan telemetri struktural mikro pasar modal terverifikasi.
      </p>
    </div>

    <!-- 3 Core Values Cards -->
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        values.map((val) => (
          <article class="reveal group relative flex flex-col justify-between rounded-2xl border border-white/[0.08] bg-ink-900/60 p-7 backdrop-blur-md transition-all duration-300 hover:border-peach-400/30 hover:bg-ink-900/80 hover:shadow-[0_12px_40px_rgba(255,184,121,0.06)]">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-semibold tracking-wider text-peach-300">
                  {val.num}
                </span>
                <div class="grid size-9 place-items-center rounded-lg border border-white/10 bg-white/[0.03] text-peach-300 transition-colors group-hover:border-peach-400/30 group-hover:bg-peach-400/10">
                  <Icon name={val.icon} size={16} />
                </div>
              </div>
              <h3 class="mt-5 text-xl font-bold tracking-tight text-white">
                {val.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">
                {val.desc}
              </p>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-peach-300/80">
              <span class="size-1 rounded-full bg-peach-400"></span>
              <span>Fondasi Matematika &amp; KSEI</span>
            </div>
          </article>
        ))
      }
    </div>

    <!-- The Avenia Way Bento Grid -->
    <div class="mt-16 rounded-3xl border border-white/[0.08] bg-white/[0.015] p-6 lg:p-8">
      <div class="mb-8 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
        <div>
          <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-peach-300">THE AVENIA WAY</span>
          <h3 class="mt-1 text-2xl font-bold tracking-tight text-white">Tiga Pilar Metodologi Objektif</h3>
        </div>
        <p class="max-w-md text-xs leading-relaxed text-slate-400 sm:text-right">
          Membedakan riset Avenia dari spekulasi emosional pasar konvensional dengan fakta hukum dan matematika terverifikasi.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          bento.map((b) => (
            <div class="relative flex flex-col justify-between rounded-2xl border border-white/[0.07] bg-ink-900/70 p-6 backdrop-blur-sm transition-all hover:border-white/15">
              <div>
                <div class="flex items-center justify-between">
                  <span class="rounded-full border border-peach-400/20 bg-peach-400/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-peach-300">
                    {b.badge}
                  </span>
                  <Icon name={b.icon} size={16} class="text-slate-500" />
                </div>
                <h4 class="mt-4 text-lg font-bold text-white">{b.title}</h4>
                <p class="mt-2 text-xs leading-relaxed text-slate-400">{b.desc}</p>
              </div>

              <div class="mt-6 border-t border-white/[0.06] pt-4">
                <span class="block font-mono text-2xl font-extrabold text-white">{b.stat}</span>
                <span class="text-[11px] font-medium text-slate-500">{b.statLabel}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
